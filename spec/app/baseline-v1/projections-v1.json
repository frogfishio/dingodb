    "spec/app/baseline-v1/operations-v1.json"
  ],
  "policy": {
    "backends": [
      "embedded",
      "remote"
    ],
    "definition": "Local (embedded) and remote adapters are projections of the same application contract; only transport envelope may differ.",
    "no_unexplained_remote_only": true,
    "outcomes_file": "spec/app/baseline-v1/outcomes-v1.json"
  },
  "fields": {
    "must_match": [
      "public_outcome_kind_or_error_code",
      "semantic_value_or_absence",
      "document_version",
      "coverage_report",
      "receipt.durability_class",
      "receipt.new_version",
      "operation_id_replay_behavior",
      "cursor_binding_identity"
    ],
    "may_differ": [
      "transport.endpoint",
      "transport.tls_presentation",
      "transport.correlation_id",
      "transport.deadline_clock_source",
      "diagnostic_detail_text_english"
    ],
    "never_public": [
      "filesystem_path",
      "raw_wire_json_as_app_return",
      "caller_supplied_heap_id_override",
      "cross_heap_join_handle"
    ]
  },
  "rules": [
    {
      "rule_id": "PAR-001",
      "name": "semantic_identity",
      "statement": "For the same HeapId, CollectionId, request fingerprint, authority, and operation_id, public outcome kind/ErrorCode and semantic fields (value, version, coverage, receipt durability class) MUST be identical on embedded and remote.",
      "applies_to": "all_operations_after_bind",
      "forbidden": [
        "remote-only success shape that embedded cannot express",
        "different ErrorCode for the same lower condition",
        "silently coercing coverage_incomplete to not_found on either backend"
      ]
    },
    {
      "rule_id": "PAR-002",
      "name": "constructor_only_switch",
      "statement": "Application source may change only the HeapClient constructor between embedded and remote; collection methods share one contract.",
      "applies_to": [
        "apb.heap.bind"
      ],
      "forbidden": [
        "caller-supplied HeapId",
        "raw wire JSON in app source",
        "filesystem path as public API"
      ]
    },
    {
      "rule_id": "PAR-003",
      "name": "transport_envelope_only",
      "statement": "Fields that may differ without breaking parity: connection endpoint, TLS material presentation, transport deadline wiring, wire framing. They MUST NOT change semantic ErrorCode or success kind.",
      "applies_to": "all_remote_paths"
    },
    {
      "rule_id": "PAR-004",
      "name": "auth_surface",
      "statement": "authentication_failed and permission_denied are public on both; embedded may use local master/app key ceremony but projects to the same codes.",
      "codes": [
        "authentication_failed",
        "permission_denied"
      ]
    },
    {
      "rule_id": "PAR-005",
      "name": "no_unexplained_remote_only",
      "statement": "Any error observed only on remote MUST be one of public_error_codes and listed under remote_specific_allowed. Inventing remote-only codes is forbidden.",
      "remote_specific_allowed": [
        {
          "code": "deadline_exceeded",
          "when": "remote connect/request deadline"
        },
        {
          "code": "protocol_violation",
          "when": "malformed wire or reserved wire product use"
        },
        {
          "code": "stale_route",
          "when": "cached placement stale (if cluster path present; single-node rarely)"
        },
        {
          "code": "partition_unavailable",
          "when": "partition offline (future parity; not single-node product claim)"
        },
        {
          "code": "io",
          "when": "transport IO"
        },
        {
          "code": "authentication_failed",
          "when": "credential rejection at remote"
        }
      ]
    },
    {
      "rule_id": "PAR-006",
      "name": "receipt_parity",
      "statement": "Receipts report the same durability class and version semantics on both backends; remote may add transport correlation id without changing receipt semantic fields."
    },
    {
      "rule_id": "PAR-007",
      "name": "cursor_parity",
      "statement": "Authenticated cursors bind Heap/collection/view/plan/parameters; a cursor valid on one backend MUST NOT be accepted on another Heap; mismatch \u2192 consistency_violation on both."
    },
    {
      "rule_id": "PAR-008",
      "name": "coverage_parity",
      "statement": "coverage_incomplete and payload_partial/data_damaged MUST project identically; remote MUST NOT invent values when embedded would refuse."
    },
    {
      "rule_id": "PAR-009",
      "name": "operation_id_idempotency",
      "statement": "Stable operation_id retry with same fingerprint replays the same public outcome; fingerprint conflict \u2192 consistency_violation on both backends."
    },
    {
      "rule_id": "PAR-010",
      "name": "reserved_wire",
      "statement": "Ops bound to reserved wire (e.g. rql_query 118) MUST NOT claim product parity until wire active and owning package accept; both backends refuse product use with protocol_violation / wire_op_reserved."
    },
    {
      "rule_id": "PAR-011",
      "name": "bulk_item_parity",
      "statement": "Bulk per-item outcomes (committed/rejected/uncertain/not_attempted) use the same public kinds; uncertain requires recovery_handle on both."
    },
    {
      "rule_id": "PAR-012",
      "name": "cross_heap_impossible",
      "statement": "No API projects results that compose two HeapIds; handles are Heap-bound on embedded and remote."
    }
  ],
