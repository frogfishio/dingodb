    "amend_app0": "This file supersedes inventable gaps; APP-0 error_mapping is amended in the same change for missing codes.",
    "honesty": "Gone is gone; incomplete coverage is coverage_incomplete; damage is data_damaged/payload_partial; never verified-corrupt.",
    "retry": "Retry only when retryable true AND operation is read-only or carries stable operation_id AND deadline/authority/fingerprint rules from APP-0 hold."
  },
  "public_error_codes": [
    "already_exists",
    "not_found",
