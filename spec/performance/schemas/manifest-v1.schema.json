{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://residiuumdb.org/schemas/residiuum-pqh-manifest-v1.json",
  "title": "residiuum-pqh-manifest-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "profile",
    "run_id",
    "layer",
    "source_revision",
    "cell_id",
    "seed"
  ],
  "properties": {
    "format": {
      "const": "residiuum-pqh-manifest-v1"
    },
    "profile": {
      "const": "residiuum-performance-qualification-v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "type": "string",
      "minLength": 1
    },
    "cell_id": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "work_root": {
      "type": "string"
    },
    "budget_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "budget_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "build_kind": {
      "enum": [
        "release",
        "debug"
      ]
    }
  }
}
