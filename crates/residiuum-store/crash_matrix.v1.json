{
  "version": 1,
  "title": "Residiuum store crash-consistency matrix (DEF-022)",
  "invariants": [
    "no_fabricated_committed_event",
    "no_lost_durable_acknowledgement",
    "no_duplicated_event_identity",
    "derived_not_ahead_of_authority",
    "surviving_evidence_salvageable"
  ],
  "operations": [
    {
      "id": "store_create",
      "description": "Create a new store directory and first active segment",
      "persistence_order": [
        "create_dirs",
        "writer_lock.acquire",
        "write_store_id",
        "write_meta",
        "write_store_descriptor",
        "root.dir_sync",
        "active.start_segment",
        "active.persist_header",
        "index_cache.persist",
        "catalog.refresh"
      ],
      "failpoints": [
        {
          "name": "store.create.after_meta",
          "ci_subset": true,
          "expected_on_reopen": {
            "acknowledged_visible": false,
            "no_fabricated_commit": true,
            "salvageable": true,
            "prior_durable_retained": true,
            "notes": "Create aborts after store-info meta; reopen must not invent live data. May look incomplete or recreate cleanly."
          }
        },
        {
          "name": "store.create.after_active_header",
          "ci_subset": false,
          "expected_on_reopen": {
            "acknowledged_visible": false,
            "no_fabricated_commit": true,
            "salvageable": true,
            "prior_durable_retained": true,
            "notes": "Active header may exist; no item events."
          }
        }
      ]
    },
    {
      "id": "put_durable",
      "description": "Inline put with DurabilityMode::Durable (append + fsync)",
      "persistence_order": [
        "encode_frame_memory",
        "active.append_in_memory",
        "active.write_tail",
        "active.file.sync_all",
        "active.dir_sync",
        "index.apply_event",
        "index_cache.persist",
        "catalog.refresh"
      ],
      "failpoints": [
        {
          "name": "store.active.write_tail.before",
          "ci_subset": true,
          "expected_on_reopen": {
            "acknowledged_visible": false,
            "no_fabricated_commit": true,
            "salvageable": true,
            "prior_durable_retained": true,
            "notes": "No bytes written for this put; prior durable keys remain."
          }
        },
        {
          "name": "store.active.write_tail.after_write",
          "ci_subset": true,
          "expected_on_reopen": {
            "acknowledged_visible": null,
            "no_fabricated_commit": true,
            "salvageable": true,
            "prior_durable_retained": true,
            "notes": "Buffered write may or may not reach stable storage without sync; recovery keeps verified prefix only. Must not fabricate if frame incomplete."
          }
        },
        {
          "name": "store.active.write_tail.after_sync",
          "ci_subset": true,
          "expected_on_reopen": {
            "acknowledged_visible": true,
            "no_fabricated_commit": true,
            "salvageable": true,
            "prior_durable_retained": true,
            "notes": "Authoritative bytes synced; if op returned before this failpoint, receipt was not issued — post-sync failure leaves durable-on-disk (may be visible on reopen even if caller saw error)."
          }
        },
        {
          "name": "store.active.dir_sync",
          "ci_subset": false,
          "expected_on_reopen": {
            "acknowledged_visible": true,
            "no_fabricated_commit": true,
            "salvageable": true,
            "prior_durable_retained": true,
            "notes": "File sync already done; dir sync failure still leaves frame recoverable on same FS."
          }
        },
        {
          "name": "store.index_cache.before_write",
          "ci_subset": false,
          "expected_on_reopen": {
            "acknowledged_visible": true,
            "no_fabricated_commit": true,
            "salvageable": true,
            "prior_durable_retained": true,
            "notes": "Derived cache is optional; authority is segments."
          }
        },
        {
          "name": "store.index_cache.after_write",
          "ci_subset": false,
          "expected_on_reopen": {
            "acknowledged_visible": true,
            "no_fabricated_commit": true,
            "salvageable": true,
            "prior_durable_retained": true,
            "notes": "Cache may be partial; rebuild from segments wins."
          }
        },
        {
          "name": "store.active.write_tail.short_write",
          "ci_subset": true,
          "expected_on_reopen": {
            "acknowledged_visible": false,
            "no_fabricated_commit": true,
            "salvageable": true,
            "prior_durable_retained": true,
            "notes": "Partial frame bytes may exist; recovery keeps verified prefix only. Unacked put must not appear as live."
          }
        }
      ]
    },
    {
