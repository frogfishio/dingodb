          "ci_subset": true,
          "fault": "enospc",
          "expected_on_reopen": {
            "acknowledged_visible": false,
            "no_fabricated_commit": true,
            "salvageable": true,
            "prior_durable_retained": true,
            "notes": "ENOSPC before any new bytes; prior durable retained; put not visible."
          }
        },
        {
          "name": "store.active.write_tail.before",
          "ci_subset": true,
          "fault": "permission",
          "expected_on_reopen": {
            "acknowledged_visible": false,
            "no_fabricated_commit": true,
            "salvageable": true,
            "prior_durable_retained": true,
            "notes": "Permission denied before write; prior durable retained."
          }
        }
      ]
    },
