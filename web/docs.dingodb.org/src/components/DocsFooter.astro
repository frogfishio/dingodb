---
import release from '../data/release.json';
import ExternalLink from './ExternalLink.astro';
---

<footer class="docs-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-title">DingoDB documentation</p>
      <p class="footer-warn">DingoDB is experimental software.</p>
    </div>
    <ul>
      <li><a href="/status/known-limitations/">Known limitations</a></li>
      <li><a href="/status/capabilities/">Capabilities</a></li>
      <li><a href="/specifications/">Specifications</a></li>
      <li><a href="/contributing/">Contributing</a></li>
      <li><ExternalLink href={release.mainSite}>Product site</ExternalLink></li>
      <li><ExternalLink href={`${release.mainSite}/privacy/`}>Privacy</ExternalLink></li>
      <li><ExternalLink href={release.github}>GitHub</ExternalLink></li>
    </ul>
    <div class="meta-line">
      <p>Docs revision: <code>{release.sourceRevision}</code></p>
      <p>Product: <code>{release.productVersion}</code></p>
      <p>Schema: <code>{release.contentSchemaVersion}</code> · {release.generatedAt}</p>
    </div>
  </div>
</footer>

<style>
  .docs-footer {
    margin-top: var(--space-8);
    padding: var(--space-6) 0;
    border-top: 1px solid var(--line);
    background: color-mix(in srgb, var(--line) 18%, var(--paper));
  }

  .footer-grid {
    display: grid;
    gap: var(--space-5);
  }

  .footer-title {
    margin: 0 0 0.35rem;
    font-weight: 700;
  }

  .footer-warn {
    margin: 0;
    color: var(--warning);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .docs-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .docs-footer a {
    color: var(--ink);
    text-decoration: none;
  }

  .docs-footer a:hover {
    color: var(--signal);
  }

  .docs-footer p {
    margin: 0 0 0.25rem;
  }

  @media (min-width: 800px) {
    .footer-grid {
      grid-template-columns: 1.2fr 1fr 1.2fr;
    }
  }
</style>
