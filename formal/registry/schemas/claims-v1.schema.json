{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "residiuum-formal-claims-v1"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FAS-CLAIM-"
          },
          "title": {
            "type": "string"
          },
          "theorem_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}
