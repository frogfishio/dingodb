{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://residiuum.local/formal/registry/schemas/theorems-v1.schema.json",
  "title": "residiuum-formal-theorems-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile_scope", "items"],
  "properties": {
    "schema": { "const": "residiuum-formal-theorems-v1" },
    "profile_scope": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "family", "title", "property_class", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FAS-(FND|CON|SEC|ATM|CLU)-[A-Z0-9-]+-[0-9]{3}$"
          },
          "version": { "type": "integer", "minimum": 1 },
          "family": {
            "type": "string",
            "enum": ["foundation", "consistency", "security", "atomics", "cluster"]
          },
          "title": { "type": "string", "minLength": 1 },
          "property_class": {
            "type": "string",
            "enum": ["safety", "liveness", "refinement", "preservation", "complexity"]
          },
          "statement_ref": { "type": "string" },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "specified",
              "model_checked_bounded",
              "machine_proved",
              "implementation_connected",
              "physically_qualified",
              "revoked"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "result_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "wave0_stub": { "type": "boolean" }
        }
      }
    }
  }
}
