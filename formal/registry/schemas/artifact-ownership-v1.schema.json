{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "residiuum-formal-artifact-ownership-v1"
    },
    "source": {
      "type": "string"
    },
    "package_accept": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "disposition",
          "packages"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "register_in_FAS0",
              "historical",
              "unconnected",
              "tooling"
            ]
          },
          "packages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "theorem_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
